# Optional RPC overrides only. Private keys are loaded from ignored mode-600
# files generated from macOS Keychain; do not place them in this file.

RPC_URL_SOLANA_TESTNET=https://api.devnet.solana.com
RPC_URL_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com

RPC_URL_SOLANA_MAINNET=https://api.mainnet-beta.solana.com
RPC_URL_ROBINHOOD_MAINNET=https://rpc.mainnet.chain.robinhood.com

# Optional explicit binary path for deploy/hash verification.
OFT_PROGRAM_BINARY=
OFT_PROGRAM_MAX_LEN=600000

# Only use this with a private RPC that accepts sustained program-upload traffic.
# The default direct-TPU QUIC transport is safer for public Solana RPCs.
SOLANA_DEPLOY_USE_RPC=0
